# TEMPLATE ONLY. Activate after provisioning and validating the isolated runner.
# Repository layout: Unity project at root; this toolkit at Automation/.
name: lks-ci
on:
  pull_request:
  merge_group:
    types: [checks_requested]
  push:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: lks-ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
jobs:
  policy:
    uses: ./.github/workflows/lks-tooling.yml
  unity:
    # Never run an untrusted fork on a runner with a Unity license or internal access.
    if: vars.LKS_CI_READY == 'true' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
    runs-on: [self-hosted, Windows, X64, lks-ephemeral]
    environment: unity-ci
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          lfs: true
          persist-credentials: false
      - name: Verify provisioning
        shell: pwsh
        env:
          READY: ${{ vars.LKS_CI_READY }}
        run: |
          if ($env:READY -ne 'true') { throw 'CI provisioning is incomplete.' }
          if (!$env:UNITY_EDITOR_PATH) { throw 'Runner must supply UNITY_EDITOR_PATH.' }
      - name: Unity script compilation
        shell: pwsh
        run: ./Automation/tools/Invoke-UnityChecks.ps1 -ProjectPath . -UnityPath $env:UNITY_EDITOR_PATH -Mode Compile
      - name: EditMode tests
        shell: pwsh
        run: ./Automation/tools/Invoke-UnityChecks.ps1 -ProjectPath . -UnityPath $env:UNITY_EDITOR_PATH -Mode EditMode
      - name: PlayMode tests
        shell: pwsh
        run: ./Automation/tools/Invoke-UnityChecks.ps1 -ProjectPath . -UnityPath $env:UNITY_EDITOR_PATH -Mode PlayMode
      - name: Windows build
        shell: pwsh
        run: ./Automation/tools/Invoke-UnityChecks.ps1 -ProjectPath . -UnityPath $env:UNITY_EDITOR_PATH -Mode Build
      - name: Upload diagnostics
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2; re-verify at install
        with:
          name: diagnostics-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            TestResults/*/*.log
            TestResults/*/*.xml
          retention-days: 7
          if-no-files-found: error
      - name: Upload build
        if: success()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: windows-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: Builds/
          retention-days: 14
          if-no-files-found: error
  gate:
    name: Unity validation gate
    if: always()
    needs: [policy, unity]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - shell: pwsh
        env:
          POLICY: ${{ needs.policy.result }}
          UNITY: ${{ needs.unity.result }}
        run: |
          . ./Automation/tools/UnityGate.ps1
          Assert-LksGate -Policy $env:POLICY -Unity $env:UNITY
# Read the actual check context returned by GitHub before making it required.
# Add the separate trusted merge-policy check before enabling auto-merge.
# Fork PRs intentionally fail the aggregate gate; use an isolated review process.
