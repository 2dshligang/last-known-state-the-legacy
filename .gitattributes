* text=auto eol=lf
*.cs text diff=csharp
*.shader text
*.hlsl text
*.compute text
*.json text
*.asmdef text
*.asmref text
*.md text
*.yml text
*.yaml text
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf

